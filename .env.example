# Токен Telegram-бота из @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Agent API из личного кабинета https://agentapi.ru
AGENTAPI_KEY=
AGENTAPI_BASE_URL=https://api.agentapi.ru/v1/ai
AGENTAPI_MODEL=deepseek/deepseek-v4-flash
# Пусто — бот доступен всем; иначе Telegram user ID через запятую
ALLOWED_USER_IDS=
MAX_CONCURRENT_REQUESTS=3
REQUEST_COOLDOWN_SECONDS=3
